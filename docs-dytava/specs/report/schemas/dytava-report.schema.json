{
  "$id": "https://dytava.example/specs/report/1.0.0/dytava-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "dytava-report/1.0.0"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "completion_state": {
      "type": "string",
      "const": "COMPLETED"
    },
    "current": {
      "type": "boolean",
      "const": true
    },
    "ocr_review": {
      "type": "string",
      "enum": [
        "NOT_REQUIRED",
        "CONFIRMED"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "type": "string",
      "enum": [
        "A_TO_B",
        "B_TO_A"
      ]
    },
    "direction_confirmed": {
      "type": "boolean"
    },
    "inputs": {
      "type": "object",
      "properties": {
        "A": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "format": {
              "type": "string"
            },
            "sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "size_bytes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "scope": {
              "type": "string"
            },
            "parser_version": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "label",
            "name",
            "format",
            "sha256",
            "size_bytes",
            "scope",
            "parser_version"
          ],
          "additionalProperties": false
        },
        "B": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "format": {
              "type": "string"
            },
            "sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "size_bytes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "scope": {
              "type": "string"
            },
            "parser_version": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "label",
            "name",
            "format",
            "sha256",
            "size_bytes",
            "scope",
            "parser_version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "A",
        "B"
      ],
      "additionalProperties": false
    },
    "policy_id": {
      "type": "string"
    },
    "policy_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "import_config_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "matching_mode": {
      "type": "string",
      "enum": [
        "KEY",
        "POSITIONAL"
      ]
    },
    "key_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "field_mapping": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "left": {
            "type": "string"
          },
          "right": {
            "type": "string"
          }
        },
        "required": [
          "left",
          "right"
        ],
        "additionalProperties": false
      }
    },
    "policy": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "matched_cell_pairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exact": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "equivalent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "different": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unresolved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "added_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "removed_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "added_fields": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "removed_fields": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rows_a": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "rows_b": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "fields_a": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "fields_b": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "matched_cell_pairs",
        "exact",
        "equivalent",
        "different",
        "unresolved",
        "added_rows",
        "removed_rows",
        "rows_a",
        "rows_b",
        "fields_a",
        "fields_b"
      ],
      "additionalProperties": false
    },
    "details_scope": {
      "type": "string",
      "enum": [
        "FULL_COMPARISON",
        "DIFFERENCES_ONLY",
        "PROVIDED_DETAILS"
      ]
    },
    "differences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "CELL",
              "ROW",
              "FIELD"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "EXACT",
              "EQUIVALENT",
              "DIFFERENT",
              "UNRESOLVED",
              "ADDED",
              "REMOVED"
            ]
          },
          "field": {
            "type": "string"
          },
          "key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "left": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "raw_kind": {
                    "type": "string",
                    "enum": [
                      "TEXT",
                      "NUMBER",
                      "BOOLEAN",
                      "NULL",
                      "BLANK",
                      "EMPTY_STRING"
                    ]
                  },
                  "raw": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "normalized": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reference": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string"
                          },
                          "location": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "location"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "raw"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "right": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "raw_kind": {
                    "type": "string",
                    "enum": [
                      "TEXT",
                      "NUMBER",
                      "BOOLEAN",
                      "NULL",
                      "BLANK",
                      "EMPTY_STRING"
                    ]
                  },
                  "raw": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "normalized": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reference": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string"
                          },
                          "location": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "location"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "raw"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "rule_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "kind",
          "status",
          "key",
          "left",
          "right"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata_complete": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "report_id",
    "completion_state",
    "current",
    "ocr_review",
    "generated_at",
    "engine_version",
    "direction",
    "direction_confirmed",
    "inputs",
    "policy_id",
    "policy_digest",
    "import_config_revision",
    "matching_mode",
    "key_fields",
    "field_mapping",
    "policy",
    "summary",
    "details_scope",
    "differences",
    "warnings",
    "metadata_complete"
  ],
  "additionalProperties": false
}
