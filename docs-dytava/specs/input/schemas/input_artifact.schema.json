{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dytava.example/specs/input/0.1.0/input_artifact.schema.json",
  "title": "input_artifact — DRAFT 0.1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "source_side": {
      "enum": [
        "A",
        "B"
      ]
    },
    "file_name": {
      "type": "string",
      "minLength": 1
    },
    "name_origin": {
      "enum": [
        "provider",
        "generated"
      ]
    },
    "format": {
      "anyOf": [
        {
          "enum": [
            "xlsx",
            "csv",
            "tsv",
            "json",
            "jsonl",
            "xls",
            "xlsm",
            "ods",
            "pdf",
            "image",
            "xml",
            "html",
            "xlsb"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "size_bytes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "access_ref": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "android_saf",
            "ios_document",
            "sandbox",
            "fixture"
          ]
        },
        "token": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "token"
      ],
      "additionalProperties": false
    },
    "selected_scope": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "excel"
                  },
                  "sheet_name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "range": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[A-Z]{1,3}[1-9][0-9]*:[A-Z]{1,3}[1-9][0-9]*$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "sheet_name",
                  "range"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "delimited"
                  },
                  "first_record": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "last_record": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "first_record",
                  "last_record"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "json"
                  },
                  "records_pointer": {
                    "type": "string",
                    "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
                  }
                },
                "required": [
                  "kind",
                  "records_pointer"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "ocr"
                  },
                  "page": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "kind",
                  "page"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "declared_mime_type": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "file_extension": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "source_side",
    "file_name",
    "name_origin",
    "format",
    "size_bytes",
    "sha256",
    "access_ref",
    "selected_scope"
  ],
  "additionalProperties": false,
  "$defs": {
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "excel"
            },
            "sheet_name": {
              "type": "string",
              "minLength": 1
            },
            "range": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Z]{1,3}[1-9][0-9]*:[A-Z]{1,3}[1-9][0-9]*$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "sheet_name",
            "range"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "delimited"
            },
            "first_record": {
              "type": "integer",
              "minimum": 1
            },
            "last_record": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "first_record",
            "last_record"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "json"
            },
            "records_pointer": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
            }
          },
          "required": [
            "kind",
            "records_pointer"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ocr"
            },
            "page": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "page"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "description": "Lifecycle envelope. null means not yet known, never fabricate metadata. Handoff additionally requires format/hash/size/scope resolved; access token is local and must be redacted from reports."
}
