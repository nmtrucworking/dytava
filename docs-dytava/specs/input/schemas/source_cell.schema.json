{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dytava.example/specs/input/0.1.0/source_cell.schema.json",
  "title": "source_cell — DRAFT 0.1.0",
  "type": "object",
  "properties": {
    "raw_kind": {
      "enum": [
        "xlsxNumber",
        "xlsxString",
        "xlsxSharedString",
        "xlsxBoolean",
        "xlsxDateISO",
        "csvText",
        "jsonNumber",
        "jsonString",
        "jsonBoolean",
        "jsonNull",
        "formula",
        "error",
        "blank",
        "missing",
        "ocrText"
      ]
    },
    "lexical_status": {
      "enum": [
        "PRESERVED",
        "UNAVAILABLE",
        "NOT_APPLICABLE"
      ]
    },
    "raw_lexeme": {
      "type": "string"
    },
    "display_text": {
      "type": "string"
    },
    "format_code": {
      "type": "string"
    },
    "formula": {
      "type": "string",
      "minLength": 1
    },
    "formula_cache_status": {
      "enum": [
        "NOT_FORMULA",
        "PRESENT_UNVERIFIED",
        "MISSING",
        "KNOWN_STALE"
      ]
    },
    "cached_value": {
      "type": "object",
      "properties": {
        "raw_kind": {
          "enum": [
            "xlsxNumber",
            "xlsxString",
            "xlsxBoolean",
            "error"
          ]
        },
        "raw_lexeme": {
          "type": "string"
        }
      },
      "required": [
        "raw_kind",
        "raw_lexeme"
      ],
      "additionalProperties": false
    },
    "excel_date_system": {
      "enum": [
        "1900",
        "1904"
      ]
    },
    "null_kind": {
      "enum": [
        "NONE",
        "MISSING",
        "BLANK",
        "EMPTY_STRING",
        "JSON_NULL",
        "EXCEL_ERROR"
      ]
    },
    "source_ref": {
      "$ref": "source_ref.schema.json"
    },
    "losses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "review_state": {
      "enum": [
        "NOT_REQUIRED",
        "PENDING",
        "CONFIRMED"
      ]
    },
    "confidence": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewed_text": {
      "type": "string"
    }
  },
  "required": [
    "raw_kind",
    "lexical_status",
    "formula_cache_status",
    "null_kind",
    "source_ref",
    "losses",
    "review_state"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "lexical_status": {
            "const": "PRESERVED"
          }
        }
      },
      "then": {
        "required": [
          "raw_lexeme"
        ]
      },
      "else": {
        "not": {
          "required": [
            "raw_lexeme"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "raw_kind": {
            "const": "formula"
          }
        }
      },
      "then": {
        "required": [
          "formula"
        ],
        "properties": {
          "formula_cache_status": {
            "enum": [
              "PRESENT_UNVERIFIED",
              "MISSING",
              "KNOWN_STALE"
            ]
          },
          "source_ref": {
            "properties": {
              "type": {
                "const": "excel"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "formula_cache_status": {
            "const": "NOT_FORMULA"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "formula"
              ]
            },
            {
              "required": [
                "cached_value"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "formula_cache_status": {
            "enum": [
              "PRESENT_UNVERIFIED",
              "KNOWN_STALE"
            ]
          }
        }
      },
      "then": {
        "required": [
          "cached_value"
        ]
      },
      "else": {
        "not": {
          "required": [
            "cached_value"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "raw_kind": {
            "enum": [
              "jsonNull",
              "blank",
              "missing"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "lexical_status": {
            "const": "NOT_APPLICABLE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "raw_kind": {
            "const": "missing"
          }
        }
      },
      "then": {
        "properties": {
          "source_ref": {
            "properties": {
              "exists": {
                "const": false
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "source_ref": {
            "properties": {
              "exists": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "raw_kind": {
            "const": "ocrText"
          }
        }
      },
      "then": {
        "properties": {
          "review_state": {
            "enum": [
              "PENDING",
              "CONFIRMED"
            ]
          }
        },
        "required": [
          "confidence"
        ]
      },
      "else": {
        "properties": {
          "review_state": {
            "const": "NOT_REQUIRED"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "confidence"
              ]
            },
            {
              "required": [
                "reviewed_text"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_state": {
            "const": "CONFIRMED"
          }
        }
      },
      "then": {
        "required": [
          "reviewed_text"
        ]
      },
      "else": {
        "not": {
          "required": [
            "reviewed_text"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "raw_kind": {
            "const": "jsonNull"
          }
        }
      },
      "then": {
        "properties": {
          "null_kind": {
            "const": "JSON_NULL"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "raw_kind": {
            "const": "blank"
          }
        }
      },
      "then": {
        "properties": {
          "null_kind": {
            "const": "BLANK"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "raw_kind": {
            "const": "missing"
          }
        }
      },
      "then": {
        "properties": {
          "null_kind": {
            "const": "MISSING"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "raw_kind": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "null_kind": {
            "const": "EXCEL_ERROR"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "raw_kind": {
            "enum": [
              "csvText",
              "xlsxString",
              "xlsxSharedString",
              "jsonString",
              "ocrText"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "null_kind": {
            "enum": [
              "NONE",
              "EMPTY_STRING"
            ]
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "raw_kind": {
              "enum": [
                "xlsxNumber",
                "xlsxBoolean",
                "xlsxDateISO",
                "jsonNumber",
                "jsonBoolean",
                "formula"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "null_kind": {
              "const": "NONE"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "raw_kind": {
            "enum": [
              "xlsxNumber",
              "xlsxString",
              "xlsxSharedString",
              "xlsxBoolean",
              "xlsxDateISO",
              "formula",
              "error",
              "blank"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "source_ref": {
            "properties": {
              "type": {
                "const": "excel"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "raw_kind": {
            "enum": [
              "csvText"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "source_ref": {
            "properties": {
              "type": {
                "const": "csv"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "raw_kind": {
            "enum": [
              "jsonNumber",
              "jsonString",
              "jsonBoolean",
              "jsonNull"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "source_ref": {
            "properties": {
              "type": {
                "const": "json"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "raw_kind": {
            "enum": [
              "ocrText"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "source_ref": {
            "properties": {
              "type": {
                "const": "ocr"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "raw_kind": {
            "const": "jsonNumber"
          },
          "lexical_status": {
            "const": "PRESERVED"
          }
        }
      },
      "then": {
        "properties": {
          "raw_lexeme": {
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lexical_status": {
            "const": "UNAVAILABLE"
          }
        }
      },
      "then": {
        "properties": {
          "losses": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "null_kind": {
            "const": "EMPTY_STRING"
          },
          "lexical_status": {
            "const": "PRESERVED"
          }
        }
      },
      "then": {
        "properties": {
          "raw_lexeme": {
            "const": ""
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "raw_kind": {
            "enum": [
              "csvText",
              "xlsxString",
              "xlsxSharedString",
              "jsonString",
              "ocrText"
            ]
          },
          "null_kind": {
            "const": "NONE"
          },
          "lexical_status": {
            "const": "PRESERVED"
          }
        }
      },
      "then": {
        "properties": {
          "raw_lexeme": {
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "raw_kind": {
            "const": "missing"
          }
        }
      },
      "then": {
        "properties": {
          "source_ref": {
            "properties": {
              "type": {
                "enum": [
                  "excel",
                  "json"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "format_code"
            ]
          },
          {
            "required": [
              "excel_date_system"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "source_ref": {
            "properties": {
              "type": {
                "const": "excel"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "raw_kind": {
            "const": "jsonBoolean"
          },
          "lexical_status": {
            "const": "PRESERVED"
          }
        }
      },
      "then": {
        "properties": {
          "raw_lexeme": {
            "pattern": "^(true|false)$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "raw_kind": {
            "const": "xlsxBoolean"
          },
          "lexical_status": {
            "const": "PRESERVED"
          }
        }
      },
      "then": {
        "properties": {
          "raw_lexeme": {
            "pattern": "^[01]$"
          }
        }
      }
    }
  ]
}
