{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dytava.example/specs/input/0.1.0/import_config.schema.json",
  "title": "import_config — DRAFT 0.1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "config_id": {
      "type": "string",
      "minLength": 1
    },
    "config_revision": {
      "type": "integer",
      "minimum": 1
    },
    "resource_profile_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_a": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "xlsx",
            "csv",
            "tsv",
            "json"
          ]
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "input_artifact.schema.json#/$defs/scope"
          },
          "minItems": 1
        },
        "header": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "none"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "explicit"
                },
                "row": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "mode",
                "row"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "detect"
                },
                "confirmed_row": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "mode",
                "confirmed_row"
              ],
              "additionalProperties": false
            }
          ]
        },
        "encoding": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "delimiter": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1,
              "pattern": "^[^\\r\\n\"\\u0000]$"
            },
            {
              "type": "null"
            }
          ]
        },
        "parser_profile": {
          "type": "object",
          "properties": {
            "profile_id": {
              "type": "string",
              "minLength": 1
            },
            "profile_version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "profile_id",
            "profile_version"
          ],
          "additionalProperties": false
        },
        "hidden_content": {
          "enum": [
            "include",
            "exclude",
            "review"
          ]
        },
        "merged_cells": {
          "enum": [
            "anchor_only",
            "review"
          ]
        },
        "validation_behavior": {
          "type": "object",
          "properties": {
            "on_ambiguity": {
              "const": "review"
            },
            "ragged_records": {
              "const": "reject"
            },
            "invalid_encoding": {
              "const": "reject"
            }
          },
          "required": [
            "on_ambiguity",
            "ragged_records",
            "invalid_encoding"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "artifact_id",
        "format",
        "scopes",
        "header",
        "encoding",
        "delimiter",
        "parser_profile",
        "hidden_content",
        "merged_cells",
        "validation_behavior"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "enum": [
                  "csv",
                  "tsv"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "encoding": {
                "type": "string",
                "minLength": 1
              },
              "delimiter": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1,
                "pattern": "^[^\\r\\n\"\\u0000]$"
              },
              "scopes": {
                "items": {
                  "properties": {
                    "kind": {
                      "const": "delimited"
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "delimiter": {
                "type": "null"
              },
              "encoding": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "tsv"
              }
            }
          },
          "then": {
            "properties": {
              "delimiter": {
                "const": "\t"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "xlsx"
              }
            }
          },
          "then": {
            "properties": {
              "scopes": {
                "items": {
                  "properties": {
                    "kind": {
                      "const": "excel"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "json"
              }
            }
          },
          "then": {
            "properties": {
              "scopes": {
                "items": {
                  "properties": {
                    "kind": {
                      "const": "json"
                    }
                  }
                }
              },
              "header": {
                "properties": {
                  "mode": {
                    "const": "none"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "source_b": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "xlsx",
