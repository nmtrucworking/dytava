{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dytava.example/specs/input/0.1.0/source_ref.schema.json",
  "title": "source_ref — DRAFT 0.1.0",
  "description": "Original-source coordinates. Indexes 1-based except JSON Pointer array indexes (0-based). Runtime checks address bounds, end_line and polygon bounds.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "exists": {
          "type": "boolean"
        },
        "type": {
          "const": "excel"
        },
        "sheet": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}[1-9][0-9]*$"
        }
      },
      "required": [
        "artifact_id",
        "exists",
        "type",
        "sheet",
        "address"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "exists": {
          "const": true
        },
        "type": {
          "const": "csv"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "record": {
          "type": "integer",
          "minimum": 1
        },
        "field": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "artifact_id",
        "exists",
        "type",
        "line",
        "end_line",
        "record",
        "field"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "exists": {
          "type": "boolean"
        },
        "type": {
          "const": "json"
        },
        "pointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
        }
      },
      "required": [
        "artifact_id",
        "exists",
        "type",
        "pointer"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "exists": {
          "const": true
        },
        "type": {
          "const": "ocr"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "polygon": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0
              },
              "y": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "minItems": 3
        },
        "coordinate_space": {
          "const": "oriented_image_pixels"
        },
        "image_width": {
          "type": "integer",
          "minimum": 1
        },
        "image_height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "artifact_id",
        "exists",
        "type",
        "page",
        "polygon",
        "coordinate_space",
        "image_width",
        "image_height"
      ],
      "additionalProperties": false
    }
  ]
}
