digraph G {rankdir=LR; node [shape=box,style="rounded,filled",fillcolor="#EAF2F8"]; choose[label="User selects A/B"]; validate[label="Validate + inventory"]; mapping[label="Confirm ambiguous mapping"]; run[label="Stream + compare + persist"]; result[label="Finalize audit + report"]; fail[label="Error / partial / cancel",fillcolor="#FFF1D9"]; choose->validate->mapping->run->result; validate->fail [label="invalid"]; run->fail [label="budget/cancel/error"]; }