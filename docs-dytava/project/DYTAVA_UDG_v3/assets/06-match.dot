digraph G {rankdir=TB; node [shape=diamond,style=filled,fillcolor="#FFF1D9"]; key[label="Unique stable key?"]; ordered[label="Order meaningful?"]; same[label="Strict coordinate policy?"]; manual[label="Resolvable with confidence?"]; node [shape=box,style="rounded,filled",fillcolor="#EAF2F8"]; keyed[label="KEYED + duplicate review"]; seq[label="ORDERED bounded alignment"]; pos[label="POSITIONAL"]; set[label="MULTISET candidates"]; review[label="MANUAL / AMBIGUOUS"]; key->keyed [label="yes"]; key->ordered [label="no"]; ordered->seq [label="yes"]; ordered->same [label="no"]; same->pos [label="yes"]; same->manual [label="no"]; manual->set [label="yes"]; manual->review [label="no"]; }