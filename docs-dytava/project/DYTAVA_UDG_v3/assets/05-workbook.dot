digraph G {rankdir=LR; node [shape=box,style="rounded,filled",fillcolor="#EAF2F8"]; ma[label="Sheet inventory A"]; mb[label="Sheet inventory B"]; pair[label="Name + signature candidates"]; review[label="Uncertain => manual review",fillcolor="#FFF1D9"]; queue[label="Bounded sheet work queue"]; table[label="Region matching + compare"]; agg[label="Workbook report"]; ma->pair; mb->pair; pair->review [label="ambiguous"]; pair->queue [label="accepted"]; queue->table->agg; review->queue [label="confirmed"]; }