digraph G {rankdir=TB; node [shape=diamond,style=filled,fillcolor="#FFF1D9"]; supported[label="Type supported? "]; formula[label="Formula mode? "]; equal[label="Equivalent by policy?"]; node [shape=box,style="rounded,filled",fillcolor="#EAF2F8"]; unknown[label="UNDETERMINED"]; calc[label="Formula + cache rules"]; normal[label="Typed normalization"]; eq[label="EQUIVALENT"]; diff[label="VALUE/TYPE CHANGE"]; supported->unknown [label="no"]; supported->formula [label="yes"]; formula->calc [label="formula"]; formula->normal [label="value"]; calc->equal; normal->equal; equal->eq [label="yes"]; equal->diff [label="no"]; }