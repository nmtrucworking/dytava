digraph G {rankdir=LR; node [shape=box,style="rounded,filled",fillcolor="#EAF2F8"]; ui[label="Main UI isolate"]; orch[label="Session controller"]; worker[label="Long-lived compute isolate"]; sql[label="SQLite / temporary storage"]; ui->orch [label="start, cancel"]; orch->worker [label="small control messages"]; worker->orch [label="progress, errors, completion"]; worker->sql [label="batches / indexes / diffs"]; orch->sql [label="paged result read"]; }