digraph G {rankdir=LR; node [shape=box,style="rounded,filled",fillcolor="#EAF2F8"]; draft[label="CREATED"]; inspect[label="INSPECTING"]; ready[label="READY"]; run[label="RUNNING"]; review[label="NEEDS_REVIEW",fillcolor="#FFF1D9"]; completed[label="COMPLETED",fillcolor="#E3F4E8"]; partial[label="PARTIAL",fillcolor="#FFF1D9"]; cancel[label="CANCELLED"]; fail[label="FAILED"]; draft->inspect->ready->run; run->review; review->run; run->completed; run->partial; run->cancel; run->fail; inspect->fail; }